# Supabase — get these from your Supabase project settings > API
SITE_URL=https://agentradarlive.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Preferred modern server key. Legacy projects can temporarily use
# SUPABASE_SERVICE_ROLE_KEY during key migration.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Waitlist collection is opt-in and fails closed unless explicitly set to true.
# Keep disabled until privacy, retention, deletion, and abuse controls are reviewed.
WAITLIST_ENABLED=false

# AI provider — 'anthropic' | 'openai' | 'mock'
# mock: deterministic output, no API key required (useful for CI / local dev)
AI_PROVIDER=openai

# Per-provider model (each has a sensible default if omitted)
# Pinned model is in the high-volume complimentary-token group for eligible,
# enrolled projects that share API inputs and outputs with OpenAI.
OPENAI_MODEL=gpt-5.4-nano-2026-03-17
# Anthropic default: claude-3-5-haiku-20241022
ANTHROPIC_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Fail closed before paid AI work when the full run's conservative estimate
# (enrichment retries, reclassification, translation, and summaries) exceeds this.
MAX_DAILY_AI_COST_USD=1.00

# GitHub — personal access token for Search API (5000 req/hr vs 60 unauth)
GITHUB_TOKEN=

# Cron protection — protects /api/refresh/daily from unauthorized access.
# Generate with: openssl rand -hex 32
# Set the same value in your Vercel project environment variables so that
# Vercel Cron automatically passes it as "Authorization: Bearer <CRON_SECRET>".
# Optional: cap items enriched per cron run (default: 30, hard cap: 50)
CRON_SECRET=
# DAILY_ENRICH_LIMIT=30
