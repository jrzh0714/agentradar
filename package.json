{
  "name": "agentradar",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test app/api/subscribe/route.test.ts lib/ai/enrich.test.ts lib/ai/provider.test.ts lib/backup/release-backup.test.ts lib/db/pagination.test.ts lib/ranking/score.test.ts lib/ingestion/title.test.ts lib/validation/url.test.ts lib/http/limits.test.ts lib/workflows/cost-estimation.test.ts lib/workflows/trend-detection.test.ts lib/workflows/data-quality.test.ts",
    "health": "curl -fsS ${SITE_URL:-https://agentradarlive.vercel.app}/api/health",
    "estimate": "curl -fsS -H \"Authorization: Bearer $CRON_SECRET\" ${SITE_URL:-https://agentradarlive.vercel.app}/api/pipeline/estimate",
    "refresh:stars": "tsx --conditions=react-server scripts/refresh-github-stars.ts",
    "translate": "tsx --conditions=react-server scripts/translate-items.ts",
    "cleanup:github": "tsx --conditions=react-server scripts/cleanup-github-artifacts.ts",
    "cleanup:titles": "tsx --conditions=react-server scripts/cleanup-titles.ts",
    "ingest:github": "tsx --conditions=react-server scripts/ingest-github.ts",
    "ingest:hn": "tsx --conditions=react-server scripts/ingest-hn.ts",
    "ingest:rss": "tsx --conditions=react-server scripts/ingest-rss.ts",
    "ingest:all": "tsx --conditions=react-server scripts/ingest-all.ts",
    "fix:rss-feeds": "tsx --conditions=react-server scripts/fix-rss-feeds.ts",
    "enrich": "tsx --conditions=react-server scripts/enrich-items.ts",
    "rank": "tsx --conditions=react-server scripts/rank-items.ts",
    "backup:release": "tsx --conditions=react-server scripts/backup-release.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@base-ui/react": "^1.4.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "openai": "^6.37.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "eslint": "^10",
    "eslint-config-next": "^16.3.4",
    "playwright": "^1.63.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^7",
    "ws": "^8.21.3"
  }
